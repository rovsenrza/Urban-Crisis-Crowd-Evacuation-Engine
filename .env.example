# ── Ümumi ──────────────────────────────────────────────────────────────
# SQLite (standart). PostgreSQL üçün: postgresql+psycopg://user:pass@host:5432/evac
DATABASE_URL=sqlite:///./data/evac.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_START=true
# İstəyə görə YAML konfiqurasiya faylı (mühit dəyişənləri ondan üstündür)
# CONFIG_FILE=config.yaml

# ── Operator (demo giriş) ──────────────────────────────────────────────
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=baku2026
# Skriptlər üçün statik xidmət tokeni (admin rolu). İstehsalatda boş qoyun: yalnız JWT qalır.
OPERATOR_TOKEN=demo-operator-token
# Operator hesabının rolu: admin | dispatcher | observer
OPERATOR_ROLE=admin
# Yalnız oxuma hüquqlu ikinci hesab (parol boşdursa söndürülür)
OBSERVER_USERNAME=observer
OBSERVER_PASSWORD=baku2026-view
# JWT imza açarı (HS256). İstehsalatda mütləq uzun təsadüfi dəyərlə əvəz edin.
JWT_SECRET=demo-jwt-secret-change-me
# JWT sessiyasının müddəti (dəqiqə)
JWT_TTL_MIN=480
# Bir IP-dən dəqiqədə icazə verilən giriş cəhdi
LOGIN_RATE_PER_IP=10

# ── SOS endpointinin sui-istifadədən qorunması ─────────────────────────
# Sürət hədlərinin pəncərəsi (s)
SOS_RATE_WINDOW_S=60
# Bir vətəndaş id-sindən pəncərə ərzində qəbul edilən SOS sorğusu
SOS_RATE_PER_CITIZEN=5
# Bir müştəri ünvanından (IP) pəncərə ərzində qəbul edilən SOS sorğusu
SOS_RATE_PER_IP=30
# Dublikat filtri: bir ünvan eyni yeri və eyni təhlükə növünü pəncərədə neçə dəfə bildirə bilər (0 = söndürülür)
SOS_FLOOD_SAME_SPOT=1
# «Eyni yer» üçün koordinatın onluq dəqiqliyi (4 ≈ 10 m)
SOS_FLOOD_PRECISION=4
# Yük atma: hamıdan pəncərə ərzində qəbul edilən SOS sayı (0 = hədd yoxdur; real siqnalları da kəsir)
SOS_GLOBAL_PER_WINDOW=0
# Şəhər mərkəzindən bu məsafədən (km) uzaq SOS rədd edilir
SOS_MAX_DISTANCE_KM=60
# Xidmət ərazisinin və xəritənin mərkəzi
CITY_CENTER_LAT=40.4
CITY_CENTER_LNG=49.87
# Yalnız X-Forwarded-For başlığını özü yazan etibarlı proksi arxasında true edin
TRUST_FORWARDED_FOR=false

# ── Marşrutlaşdırma ────────────────────────────────────────────────────
# simulated (standart, daxili yol qrafı) | osrm (ictimai OSRM API)
ROUTING_PROVIDER=simulated
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=foot
# Xarici marşrut API-si üçün gözləmə müddəti (s) və circuit breaker: ardıcıl uğursuzluq həddi,
# bərpa sınağına qədər fasilə (s), statik koordinat matrisində düz xətt məsafəsinin əmsalı
OSRM_TIMEOUT_S=5
ROUTING_BREAKER_FAILURES=3
ROUTING_BREAKER_RESET_S=30
ROUTING_STATIC_DETOUR=1.35
WALK_SPEED_MPS=1.4
# Maneəsiz profil (əlil arabası / köməkli hərəkət) üçün sürət
ACCESSIBLE_SPEED_MPS=0.9
BRIGADE_SPEED_MPS=12
NEAREST_LIMIT=5

# ── Böhran hədləri ─────────────────────────────────────────────────────
SOS_CLUSTER_RADIUS_M=500
SOS_CLUSTER_WINDOW_MIN=5
SOS_CLUSTER_MIN_COUNT=4
REROUTE_OCCUPANCY_PCT=90
CRITICAL_OCCUPANCY_PCT=95
ALERT_COOLDOWN_MIN=10
OCCUPANCY_YELLOW_PCT=70
OCCUPANCY_RED_PCT=90
SOS_DEDUP_WINDOW_S=60

# ── Simulyasiya ────────────────────────────────────────────────────────
SIM_ENABLED=true
BRIGADE_SIM_ENABLED=true
BRIGADE_TICK_S=2
BRIGADE_SIM_SPEEDUP=8

# ── scripts/simulate.py ────────────────────────────────────────────────
API_URL=http://localhost:8000
